// Настройки сборки страницы «COO Hub · Радар» из выгрузки витрины.
// Строки, которые начинаются с //, — пояснения, конвертер их пропускает.
// Всё, чего здесь нет, конвертер определяет сам и пишет в отчёт, что именно решил.
{
  // Отчётный месяц. null — последний месяц в выгрузке. Можно задать и из командной строки: --month 2026-09
  "report_month": null,

  // Если одна метрика лежит в витрине в нескольких вариантах (metric_option / data_type),
  // конвертер остановится и перечислит варианты. Выберите один — для всех метрик сразу:
  //   "variants": {"*": {"metric_option": "Все юниты"}}
  // или для отдельной метрики по её русскому названию:
  //   "variants": {"Связанность": {"metric_option": "Фокусные юниты"}}
  "variants": {},

  // Как в витрине записано «итого по всем сотрудникам» в колонках emp_* и seniority*. Пустое значение — всегда «итого»;
  // если витрина пишет слово («Все», «ALL»), добавьте его сюда.
  "total_tokens": ["", "все", "всего", "итого", "all", "total", "-", "—"],
  // Колонки, по которым одна метрика раскладывается на варианты. Появилась ещё одна — добавьте и выберите значение в variants.
  "variant_columns": ["metric_option", "data_type"],

  // Корень дерева. null — единственный юнит без родителя; если таких несколько,
  // конвертер соберёт над ними общий юнит с именем root_name.
  "root_rk": null,
  "root_name": "Все юниты",
  // Сколько уровней каталога показывать (корень — 1-й уровень). null — все.
  "max_depth": null,

  // Откуда брать численность юнита для площади плиток на карте.
  // У «Недорабатывающих» знаменатель — численность юнита.
  "headcount": {"metric": "Недорабатывающие", "field": "value_denominator"},

  // Какие метрики и в каком порядке показывать. null — все из выгрузки, по sort_number.
  //   "metrics_include": ["Покрытие целями (OKR)", "Связанность", "Недорабатывающие"]
  "metrics_include": null,
  "metrics_exclude": [],

  // Подписи, которых нет в витрине: что лежит в числителе и знаменателе и как сказать разрыв до порога
  // словами. {n} — сколько штук не хватает до жёлтого порога. Ключ — русское название метрики или metric_name_eng_lower.
  // Здесь же можно поправить то, что витрина отдаёт не так:
  //   "change": "down", "red": 70, "yellow": 85, "threshold_scope": "unit_level",
  //   "perc_scale": "fraction" (значения — доли 0…1) или "percent", "yoy_base": "none", "additive": false, "hide": true
  "metrics": {
    "Покрытие целями (OKR)": {"unit_num": "юнитов с целями", "unit_den": "юнитов", "gap_tpl": "поставить цели ещё {n} юнитам"},
    "Использование": {"unit_num": "целей обновлены", "unit_den": "целей", "gap_tpl": "обновить ещё {n} целей"},
    "Выполнение": {"unit_num": "целей в прогрессе", "unit_den": "целей", "gap_tpl": "добавить прогресса на {n} целей"},
    "Связанность": {"unit_num": "целей связаны", "unit_den": "целей", "gap_tpl": "связать ещё {n} целей"},
    "Аллокация": {"unit_num": "FTE", "unit_den": "человек"},
    "Аллокация HQ": {"unit_num": "FTE", "unit_den": "человек HQ"},
    "Открыто вакансий HQ": {"unit_num": "вакансий"},
    "Свободные квоты": {"unit_num": "квот"},
    "Временные позиции": {"unit_num": "позиций"},
    "Позиции для замен": {"unit_num": "позиций"},
    "Недорабатывающие": {"unit_num": "человек", "unit_den": "человек", "gap_tpl": "вывести из недоработки {n} человек"},
    "Стоимость, руб.": {"unit_num": "рублей"},
    "Утилизация": {"unit_num": "использовано", "unit_den": "выделено", "gap_tpl": "дозагрузить {n} ресурсо-часов"}
  },

  // Короткие имена блоков для кольца радара и фразы для вердикта. Для «Целей», «Людей» и «IT» уже есть,
  // для нового блока конвертер придумает сам; поправить можно так:
  //   "blocks": {"Финансы": {"nick": "Деньги", "ring": "₽", "phrase": {"red": "Деньги в красной зоне", "amber": "Деньги на грани", "ok": "деньги в норме"}}}
  "blocks": {},
  "block_order": null,

  // Подвал страницы. {date} — дата актуальности данных витрины.
  "meta": {
    "product": "COO Hub",
    "source": "Витрина COO Hub, Greenplum",
    "owner": "Офис исполнительного директора · BI-аналитика",
    "disclaimer": "Данные витрины на {date}. Для служебного пользования — не пересылайте за пределы компании."
  }
}
